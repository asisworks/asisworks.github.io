---
import Base from '../../layouts/Base.astro';
import SeyneraLanding from '../../components/SeyneraLanding.astro';
import { products } from '../../config';
import { dictionary } from '../../i18n';
export function getStaticPaths(){return products.map(product=>({params:{product:product.id},props:{product}}))}
const { product } = Astro.props;
const t = dictionary.ru;
---
{product.id === 'seynera-reader' ? <SeyneraLanding lang="ru" /> : <Base lang="ru" title={`${product.name} — As Is Works`} path={`/${product.id}/`}><main class="placeholder shell wrap"><span class="number">{product.number}</span><h1 class="serif">{product.name}</h1><p>{t.temporary}</p><a href="/#programs">← {t.back}</a></main></Base>}
<style>.placeholder{min-height:65vh;padding-top:100px;padding-bottom:100px}.number{color:var(--accent)}h1{font-size:clamp(45px,8vw,85px);margin:16px 0}p{font-size:18px;color:var(--muted)}a{display:inline-block;margin-top:28px;color:var(--accent)}a:hover{text-decoration:underline}</style>
